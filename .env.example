# Anchor — example environment file.
# Copy to `.env` and fill in only what you need. NEVER commit `.env`.
#
# Every variable here is OPTIONAL. Anchor's deterministic linting engine runs
# fully offline with zero keys. These are only read when `llm.enabled: true`
# is set in anchor.config, and Anchor never transmits code otherwise.

# --- Optional LLM layer (bring your own key) ---------------------------------
# Only ONE of these is needed, matching `llm.provider` in your anchor.config.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Ollama runs locally and needs no key at all. This is the recommended option
# if you do not want any code leaving your machine.
OLLAMA_HOST=http://127.0.0.1:11434

# --- Optional paid tier ------------------------------------------------------
# An Ed25519-signed license key for the private tier. Verified entirely offline;
# Anchor never phones home. Leave empty to run the free tier.
ANCHOR_LICENSE_KEY=
