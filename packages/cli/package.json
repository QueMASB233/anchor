{
  "name": "@eleva/anchor",
  "version": "0.0.0",
  "description": "Anchor CLI \u2014 make AI coding agents respect your design system. Runs 100% locally.",
  "license": "MIT",
  "author": "Eleva Builds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleva-builds/anchor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/eleva-builds/anchor#readme",
  "bugs": "https://github.com/eleva-builds/anchor/issues",
  "keywords": [
    "design-system",
    "linter",
    "cli",
    "ai",
    "cursor",
    "claude-code",
    "agents-md"
  ],
  "type": "module",
  "bin": {
    "anchor": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@eleva/anchor-core": "workspace:*",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.2",
    "tinyglobby": "^0.2.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
